public final class PracByStanzz extends JavaPlugin implements Listener, CommandExecutor, TabCompleter {
 private File kitFile; private YamlConfiguration kits; private final Map<UUID,UUID> requests=new HashMap<>();
 private final Map<UUID,Long> rtpTimes=new HashMap<>(); private final LinkedHashSet<UUID> queue=new LinkedHashSet<>();
 private final Map<UUID,Object> npcs=new ConcurrentHashMap<>(); private final Map<UUID,BukkitTask> botTasks=new HashMap<>();
 private NamespacedKey botKey; private final Map<UUID,Integer> editSlots=new HashMap<>();
 public void onEnable(){ saveDefaultConfig(); botKey=new NamespacedKey(this,"prac_bot"); kitFile=new File(getDataFolder(),"kits.yml"); if(!kitFile.exists())try{getDataFolder().mkdirs();kitFile.createNewFile();}catch(IOException e){getLogger().severe(e.getMessage());} kits=YamlConfiguration.loadConfiguration(kitFile); for(String c:List.of("kit","kitadmin","rtp","rtpq","tpa","tpaccept","tpdeny","tpacancel","practicebot")){PluginCommand pc=getCommand(c);if(pc!=null){pc.setExecutor(this);pc.setTabCompleter(this);}} getServer().getPluginManager().registerEvents(this,this); Bukkit.getOnlinePlayers().forEach(this::updateBoard); getLogger().info("PracByStanzz 2.0.0 enabled"); }
 public void onDisable(){queue.clear();botTasks.values().forEach(BukkitTask::cancel);for(Object npc:new ArrayList<>(npcs.values()))destroyNpc(npc);}
 private String color(String s){return ChatColor.translateAlternateColorCodes('&',s);} private void msg(CommandSender s,String m){s.sendMessage(color("&b&lPracByStanzz &8» &f"+m));}
 private boolean admin(CommandSender s){if(s.hasPermission("pracbystanzz.admin"))return true;msg(s,"Kamu tidak punya izin.");return false;}
 private void saveKits(){try{kits.save(kitFile);}catch(IOException e){getLogger().severe("Gagal menyimpan kits.yml: "+e.getMessage());}}
 private String path(int slot){return "slots."+slot;}
 private void saveInventory(int slot,Player p){kits.set(path(slot)+".contents",p.getInventory().getContents());kits.set(path(slot)+".armor",p.getInventory().getArmorContents());kits.set(path(slot)+".offhand",p.getInventory().getItemInOffHand());saveKits();}
 private boolean hasKit(int slot){return kits.contains(path(slot)+".contents");}
 private void loadKit(int slot,Player p){if(!hasKit(slot)){msg(p,"Kit slot "+slot+" belum dibuat.");return;}String personal="players."+p.getUniqueId()+"."+slot;String source=kits.contains(personal+".contents")?personal:path(slot);p.getInventory().clear();p.getInventory().setContents((ItemStack[])kits.get(source+".contents"));p.getInventory().setArmorContents((ItemStack[])kits.get(source+".armor"));ItemStack off=kits.getItemStack(source+".offhand");p.getInventory().setItemInOffHand(off==null?new ItemStack(Material.AIR):off);p.updateInventory();msg(p,"Kit slot "+slot+" berhasil diambil.");}
 private void savePersonalInventory(int slot,Player p){String base="players."+p.getUniqueId()+"."+slot;kits.set(base+".contents",p.getInventory().getContents());kits.set(base+".armor",p.getInventory().getArmorContents());kits.set(base+".offhand",p.getInventory().getItemInOffHand());saveKits();}
 @Override public boolean onCommand(CommandSender sender,Command cmd,String label,String[] a){String c=cmd.getName().toLowerCase(Locale.ROOT); if(c.equals("kit")){if(!(sender instanceof Player p))return true;if(a.length==0){msg(p,"Gunakan /kit <slot>, /kit edit <slot>, atau /kit save <slot>.");return true;}if(a[0].equalsIgnoreCase("edit")){if(a.length<2){msg(p,"Gunakan /kit edit <slot>.");return true;}int n=number(a[1]);if(n<1||!hasKit(n)){msg(p,"Slot kit tidak tersedia.");return true;}loadKit(n,p);editSlots.put(p.getUniqueId(),n);msg(p,"Edit kit aktif. Ubah inventory, lalu gunakan /kit save.");return true;}if(a[0].equalsIgnoreCase("save")){Integer n=editSlots.get(p.getUniqueId());if(n==null){msg(p,"Aktifkan dulu dengan /kit edit <slot>.");return true;}savePersonalInventory(n,p);editSlots.remove(p.getUniqueId());msg(p,"Loadout pribadi slot "+n+" tersimpan. Kit default member lain tidak berubah.");return true;}int n=number(a[0]);if(n<1){msg(p,"Slot harus angka positif.");return true;}loadKit(n,p);return true;}
 if(c.equals("kitadmin")){if(!admin(sender))return true;if(a.length<2){msg(sender,"/kitadmin set <slot> (simpan inventory kamu) atau delete/list <slot>");return true;}if(a[0].equalsIgnoreCase("list")){Set<String> keys=kits.getConfigurationSection("slots")==null?Set.of():kits.getConfigurationSection("slots").getKeys(false);msg(sender,"Slot tersedia: "+String.join(", ",keys));return true;}int n=number(a[1]);if(n<1){msg(sender,"Slot harus angka positif.");return true;}if(a[0].equalsIgnoreCase("set")){if(!(sender instanceof Player p)){msg(sender,"Hanya player.");return true;}saveInventory(n,p);msg(p,"Kit slot "+n+" dibuat/diperbarui dari inventory kamu.");return true;}if(a[0].equalsIgnoreCase("delete")){kits.set(path(n),null);saveKits();msg(sender,"Kit slot "+n+" dihapus.");return true;}return true;}
 if(c.equals("rtp")){if(sender instanceof Player p)rtp(p);return true;}
 if(c.equals("rtpq")){if(!(sender instanceof Player p))return true;if(queue.remove(p.getUniqueId())){msg(p,"Kamu keluar dari antrean.");updateBoards();return true;}queue.add(p.getUniqueId());msg(p,"Masuk antrean PvP. Pemain dalam antrean: "+queue.size());matchQueue();updateBoards();return true;}
 if(c.equals("tpa")){if(!(sender instanceof Player p)||a.length<1)return true;Player target=Bukkit.getPlayerExact(a[0]);if(target==null||target.equals(p)){msg(p,"Pemain tidak ditemukan.");return true;}requests.put(target.getUniqueId(),p.getUniqueId());msg(p,"Permintaan TPA dikirim ke "+target.getName()+".");msg(target,p.getName()+" meminta teleport. /tpaccept atau /tpdeny");Bukkit.getScheduler().runTaskLater(this,()->{if(Objects.equals(requests.get(target.getUniqueId()),p.getUniqueId())){requests.remove(target.getUniqueId());msg(p,"Permintaan TPA kedaluwarsa.");msg(target,"Permintaan TPA kedaluwarsa.");}},20L*getConfig().getInt("tpa.timeout-seconds",60));return true;}
 if(c.equals("tpaccept")||c.equals("tpdeny")){if(!(sender instanceof Player p))return true;UUID from=requests.remove(p.getUniqueId());Player requester=from==null?null:Bukkit.getPlayer(from);if(requester==null){msg(p,"Tidak ada permintaan TPA.");return true;}if(c.equals("tpaccept")){requester.teleportAsync(p.getLocation());msg(requester,"TPA diterima.");msg(p,"Permintaan diterima.");}else{msg(requester,"TPA ditolak.");msg(p,"Permintaan ditolak.");}return true;}
 if(c.equals("tpacancel")){if(!(sender instanceof Player p))return true;boolean removed=requests.entrySet().removeIf(e->e.getValue().equals(p.getUniqueId()));msg(p,removed?"Permintaan TPA dibatalkan.":"Tidak ada permintaan yang bisa dibatalkan.");return true;}
 if(c.equals("practicebot")){if(!(sender instanceof Player p)||!admin(sender))return true;if(a.length==0){msg(p,"/practicebot spawn|remove");return true;}if(a[0].equalsIgnoreCase("spawn"))spawnCitizensBot(p);else if(a[0].equalsIgnoreCase("remove"))removeBot(p);return true;}return false;}
 private int number(String s){try{return Integer.parseInt(s);}catch(Exception e){return -1;}}
 private void rtp(Player p){long now=System.currentTimeMillis(),last=rtpTimes.getOrDefault(p.getUniqueId(),0L);long cd=getConfig().getLong("rtp.cooldown-seconds",30)*1000;if(now-last<cd){msg(p,"Tunggu "+((cd-(now-last)+999)/1000)+" detik sebelum RTP lagi.");return;}rtpTimes.put(p.getUniqueId(),now);World w=p.getWorld();int radius=getConfig().getInt("rtp.radius",5000);msg(p,"Mencari lokasi aman...");findSafe(p,w,radius,getConfig().getInt("rtp.max-attempts",40));}
 private void findSafe(Player p,World w,int radius,int left){if(left<=0){msg(p,"Lokasi aman tidak ditemukan. Coba lagi.");return;}int x=(int)(p.getLocation().getX()+ThreadLocalRandom.current().nextInt(-radius,radius+1)),z=(int)(p.getLocation().getZ()+ThreadLocalRandom.current().nextInt(-radius,radius+1));int y=w.getHighestBlockYAt(x,z)+1;Location l=new Location(w,x+.5,y,z+.5);if(l.getBlock().isPassable()&&l.clone().add(0,1,0).getBlock().isPassable()&&l.clone().subtract(0,1,0).getBlock().getType().isSolid()){p.teleportAsync(l).thenAccept(ok->Bukkit.getScheduler().runTask(this,()->msg(p,"Kamu dipindahkan ke lokasi acak.")));}else findSafe(p,w,radius,left-1);}
 private void matchQueue(){while(queue.size()>=2){Iterator<UUID> it=queue.iterator();UUID a=it.next(),b=it.next();it.remove();it.remove();Player p1=Bukkit.getPlayer(a),p2=Bukkit.getPlayer(b);if(p1==null||p2==null)continue;Location base=p1.getLocation();Location l1=base.clone().add(3,0,0),l2=base.clone().add(-3,0,0);p1.teleport(l1);p2.teleport(l2);msg(p1,"Match ditemukan: "+p2.getName());msg(p2,"Match ditemukan: "+p1.getName());}}
 private void updateBoard(Player p){ScoreboardManager sm=Bukkit.getScoreboardManager();if(sm==null)return;Scoreboard b=sm.getNewScoreboard();Objective o=b.registerNewObjective("prac","dummy",color(getConfig().getString("scoreboard.title","&b&lPRACTICE")));o.setDisplaySlot(DisplaySlot.SIDEBAR);List<String> lines=getConfig().getStringList("scoreboard.lines");int score=lines.size();for(String raw:lines){String line=color(raw.replace("%player%",p.getName()).replace("%online%",String.valueOf(Bukkit.getOnlinePlayers().size())).replace("%queue%",String.valueOf(queue.size())));if(line.length()>40)line=line.substring(0,40);String unique=line+ChatColor.COLOR_CHAR+Integer.toHexString(score%16);o.getScore(unique).setScore(score--);}p.setScoreboard(b);}
 private void updateBoards(){Bukkit.getOnlinePlayers().forEach(this::updateBoard);}
 private void spawnCitizensBot(Player owner){if(Bukkit.getPluginManager().getPlugin("Citizens")==null){msg(owner,"Citizens belum terpasang. Pasang Citizens yang cocok dengan Paper 1.21.4.");return;}try{Class<?> api=Class.forName("net.citizensnpcs.api.CitizensAPI");Object registry=api.getMethod("getNPCRegistry").invoke(null);Class<?> entityType=Class.forName("org.bukkit.entity.EntityType");Object playerType=Enum.valueOf((Class)entityType,"PLAYER");Method create=Arrays.stream(registry.getClass().getMethods()).filter(m->m.getName().equals("createNPC")&&m.getParameterCount()==2).findFirst().orElseThrow();Object npc=create.invoke(registry,playerType,color(getConfig().getString("bot.name","&cPractice Bot")));npc.getClass().getMethod("spawn",Location.class).invoke(npc,owner.getLocation().add(2,0,0));Object ent=npc.getClass().getMethod("getEntity").invoke(npc);if(ent instanceof Player bot){bot.setHealth(Math.min(bot.getMaxHealth(),getConfig().getDouble("bot.health",40)));bot.getInventory().setItemInOffHand(new ItemStack(Material.TOTEM_OF_UNDYING));bot.getPersistentDataContainer().set(botKey,PersistentDataType.BYTE,(byte)1);npcs.put(owner.getUniqueId(),npc);BukkitTask task=Bukkit.getScheduler().runTaskTimer(this,()->{if(!bot.isValid()||!owner.isOnline())return;try{if(bot.getInventory().getItemInOffHand().getType()!=Material.TOTEM_OF_UNDYING)bot.getInventory().setItemInOffHand(new ItemStack(Material.TOTEM_OF_UNDYING));if(bot.getLocation().distanceSquared(owner.getLocation())>900)bot.teleport(owner.getLocation());else{Object nav=npc.getClass().getMethod("getNavigator").invoke(npc);nav.getClass().getMethod("setTarget",Entity.class,boolean.class).invoke(nav,owner,true);if(bot.getLocation().distanceSquared(owner.getLocation())<=4.0){owner.damage(getConfig().getDouble("bot.attack-damage",5),bot);bot.swingMainHand();}}}catch(Exception ignored){}},20L,10L);botTasks.put(owner.getUniqueId(),task);msg(owner,"NPC player dibuat. Citizens menangani entity NPC; AI duel lanjutan dapat disetel di konfigurasi Citizens.");}}catch(Exception ex){getLogger().warning("Citizens NPC gagal dibuat: "+ex);msg(owner,"Gagal membuat NPC. Periksa versi Citizens di console.");}}
 private void removeBot(Player owner){Object npc=npcs.remove(owner.getUniqueId());BukkitTask task=botTasks.remove(owner.getUniqueId());if(task!=null)task.cancel();if(npc!=null){destroyNpc(npc);msg(owner,"NPC dihapus.");}else msg(owner,"Kamu tidak punya NPC aktif.");}
 private void destroyNpc(Object npc){try{npc.getClass().getMethod("destroy").invoke(npc);}catch(Exception ignored){}}
 @EventHandler public void onResurrect(EntityResurrectEvent e){if(e.getEntity() instanceof Player p&&p.getPersistentDataContainer().has(botKey,PersistentDataType.BYTE)){Bukkit.getScheduler().runTaskLater(this,()->{if(p.isValid())p.getInventory().setItemInOffHand(new ItemStack(Material.TOTEM_OF_UNDYING));},1L);}}
 @EventHandler public void onQuit(PlayerQuitEvent e){queue.remove(e.getPlayer().getUniqueId());requests.remove(e.getPlayer().getUniqueId());requests.values().removeIf(id->id.equals(e.getPlayer().getUniqueId()));removeBot(e.getPlayer());updateBoards();}
 @EventHandler public void onDamage(EntityDamageByEntityEvent e){if(e.getEntity() instanceof Player p&&p.getPersistentDataContainer().has(botKey,PersistentDataType.BYTE)&&e.getDamager() instanceof Player attacker){p.setNoDamageTicks(0);}}
 @Override public List<String> onTabComplete(CommandSender s,Command c,String a,String[] args){if(c.getName().equalsIgnoreCase("kit")&&args.length==1)return List.of("1","2","3","4","5","edit").stream().filter(x->x.startsWith(args[0])).toList();if(c.getName().equalsIgnoreCase("kitadmin")&&args.length==1)return List.of("set","delete","list");if(c.getName().equalsIgnoreCase("practicebot")&&args.length==1)return List.of("spawn","remove");if(c.getName().equalsIgnoreCase("tpa")&&args.length==1)return Bukkit.getOnlinePlayers().stream().map(Player::getName).filter(n->n.toLowerCase().startsWith(args[0].toLowerCase())).toList();return List.of();}
}
